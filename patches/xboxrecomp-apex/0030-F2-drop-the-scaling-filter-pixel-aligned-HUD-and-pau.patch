From ade2d240de93171ef784281b71c792196cc8bc26 Mon Sep 17 00:00:00 2001
From: rdr-port <rdr-port@users.noreply.github.com>
Date: Mon, 2 Nov 2026 15:56:48 -0300
Subject: [PATCH 30/47] F2: drop the scaling filter, pixel-aligned HUD and
 pause-on-focus rows (fixed values)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d/host_menu.c | 26 --------------------------
 1 file changed, 26 deletions(-)

diff --git a/src/d3d/host_menu.c b/src/d3d/host_menu.c
index ec38f3f..e5d0c6f 100644
--- a/src/d3d/host_menu.c
+++ b/src/d3d/host_menu.c
@@ -114,19 +114,6 @@ static void set_full(int i)
     nv2a_host_opts_request(&o, NV2A_OPT_FULLSCREEN);
 }
 
-static const char *const k_filter[] = { "Nítido", "Suave", "Entero", NULL };
-static int get_filter(void)
-{
-    int f = nv2a_host_opts()->present_filter;
-    return f >= 0 && f <= 2 ? f : 0;
-}
-static void set_filter(int i)
-{
-    struct nv2a_host_opts o = *nv2a_host_opts();
-    o.present_filter = i;
-    nv2a_host_opts_request(&o, NV2A_OPT_FILTER);
-}
-
 static const char *const k_aniso[] = { "No", "x2", "x4", "x8", "x16", NULL };
 static const unsigned k_aniso_v[] = { 0, 2, 4, 8, 16 };
 static int get_aniso(void)
@@ -145,21 +132,11 @@ static void set_aniso(int i)
     nv2a_host_opts_request(&o, NV2A_OPT_ANISO);
 }
 
-static const char *const k_snap[] = { "No", "Sí", NULL };
-static int get_snap(void) { return nv2a_host_opts()->snap_2d != 0; }
-static void set_snap(int i)
-{
-    struct nv2a_host_opts o = *nv2a_host_opts();
-    o.snap_2d = i;
-    nv2a_host_opts_request(&o, NV2A_OPT_SNAP2D);
-}
 
 
 static int get_dump(void) { return nv2a_d3d11_tex_dump(); }
 static void set_dump(int i) { nv2a_d3d11_tex_dump_set(i); }
 
-static int get_pause(void) { return nv2a_d3d11_pause_focus(-1); }
-static void set_pause(int i) { nv2a_d3d11_pause_focus(i); }
 static int get_vsync(void) { return nv2a_d3d11_vsync(-1); }
 static void set_vsync(int i) { nv2a_d3d11_vsync(i); }
 static int s_fps_on;
@@ -176,14 +153,11 @@ static const xbox_menu_item k_builtin[] = {
     { "widescreen", "Panorámico 16:9 (al reiniciar)", k_wide, get_wide, set_wide },
     { "window", "Tamaño de ventana", k_window, get_window, set_window },
     { "fullscreen", "Pantalla completa (F11)", k_onoff, get_full, set_full },
-    { "filter", "Filtro de escalado", k_filter, get_filter, set_filter },
     { "aniso", "Filtrado anisotrópico", k_aniso, get_aniso, set_aniso },
-    { "snap_2d", "HUD alineado a píxel", k_snap, get_snap, set_snap },
     { "tex_dump", "Volcar texturas a carpeta", k_onoff, get_dump, set_dump },
     { "vsync", "VSync (sincronía vertical)", k_onoff, get_vsync, set_vsync },
     { "fps", "Mostrar FPS", k_onoff, get_fps, set_fps },
     { NULL, "Juego", NULL, NULL, NULL },
-    { "pause_unfocused", "Pausa al cambiar de ventana", k_onoff, get_pause, set_pause },
     { "language", "Idioma (al reiniciar)", k_lang, get_lang, set_lang },
     { NULL, "Velocidad", k_speed, get_speed, set_speed },
 };

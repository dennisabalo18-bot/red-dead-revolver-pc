-    int bc3 = 0;
+    int bc3 = 0, pending = 0;
+    e->pack_wait = NULL;
     if (nv2a_tex_pack_count()) {
         /* rdr-port: the buttons in the chosen style first (F2 "Botones en
          * pantalla"), F6 or not: a font page by its hash or its indices. */
@@ -2247,6 +2251,13 @@ static int tex_upload(TexEntry *e, const Stage *t, uint64_t hash)
             pe = nv2a_tex_pack_find(hash, t->width, t->height);
             by_idx = 0;
         }
+        /* rdr-port: art not read yet goes to the loader thread; this frame
+         * draws the guest's texture and the cache re-uploads when ready. */
+        if (pe && !by_idx && pe->kind == XRTP_KIND_ART && !nv2a_tex_pack_texels_async(pe)) {
+            e->pack_wait = pe;
+            pe = NULL;

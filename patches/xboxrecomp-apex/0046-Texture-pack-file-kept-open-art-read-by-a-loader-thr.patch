+    struct nv2a_tex_pack_entry *pack_wait;
     uint64_t hash;
     int      live;
     /* What tex holds: the guest size, or a pack entry's (textures.pack);
@@ -2234,7 +2237,8 @@ static int tex_upload(TexEntry *e, const Stage *t, uint64_t hash)
     const uint8_t *p;
     uint32_t width = t->width, height = t->height, levels = t->levels;

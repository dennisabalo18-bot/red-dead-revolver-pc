 }
 
+static void loader_start(void);
+static void loader_stop(void);
+static FILE *s_file;                 /* the pack, kept open */
+static atomic_ullong s_loaded_bytes; /* texels held in memory */
+
 void nv2a_tex_pack_unload(void)
 {
     unsigned i;
+    loader_stop();
+    if (s_file) {
+        fclose(s_file);
+        s_file = NULL;
+    }
+    atomic_store(&s_loaded_bytes, 0);
     for (i = 0; i < s_count; i++)
         free(s_entries[i].data);
     free(s_entries);
@@ -268,6 +279,7 @@ int nv2a_tex_pack_load(const char *path, char *err, size_t errlen)
     s_text_scale = text_scale ? text_scale : scale;
     memcpy(s_kind_count, kinds, sizeof kinds);
     s_bc3_count = bc3;
+    loader_start();

                 e->pack_gen = pg;
             }
@@ -5502,6 +5517,7 @@ static void d3d11_flip(uint32_t surface_offset, uint32_t pitch)
         }
     }
     pump();
+    nv2a_tex_pack_frame();      /* rdr-port: read stats, memory budget */
     /* rdr-port: paused in the background. The guest's clocks, vblanks and
      * sound stop (xbox_PauseSet) and this flip waits, pumping the window,

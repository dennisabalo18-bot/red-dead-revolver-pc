     }
@@ -2379,16 +2390,20 @@ static ID3D11ShaderResourceView *tex_bind(const Stage *t)
         /* A pack toggle (nv2a_tex_pack_gen) changes what the same texels
          * upload as: re-upload as if the hash had moved. */
         uint32_t pg = nv2a_tex_pack_gen();
-        if (e->gen != g->flips || e->pack_gen != pg) {
+        /* rdr-port: the loader thread finished this one's pack entry. */
+        int ready = e->pack_wait && nv2a_tex_pack_ready(e->pack_wait);
+        if (e->gen != g->flips || e->pack_gen != pg || ready) {
             uint64_t h = tex_hash_pal(mem, t, bytes);
             s_tex_rehash++;
             e->gen = g->flips;
-            if (h != e->hash || e->pack_gen != pg) {
+            if (h != e->hash || e->pack_gen != pg || ready) {
                 s_tex_changed++;
                 /* The hash moves only with the texels: a failed upload keeps

From eff8d74cc230cc8a0403c0529feb95a85629cdff Mon Sep 17 00:00:00 2001
From: rdr-port <rdr-port@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:24:00 -0300
Subject: [PATCH 36/47] Mouse: raw input on its own thread (a message-only sink
 window), not in the presenter's once-a-frame pump: even counts per frame

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/input/mouse.c | 69 +++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 69 insertions(+)

diff --git a/src/input/mouse.c b/src/input/mouse.c
index 194966b..dc97464 100644
--- a/src/input/mouse.c
+++ b/src/input/mouse.c
@@ -731,6 +731,70 @@ static void release_at_exit(void)
     xbox_InputMouseWin32Release(NULL);
 }
 
+/* rdr-port: raw input on a thread of its own. Registered to the game's
+ * window, WM_INPUT waited in its queue until the next pump, which the
+ * D3D11 presenter runs once a frame at the flip: a frame's counts reached
+ * the camera in one lump at a moment of the presenter's, not the game's,
+ * so a steady hand turned it by 1, 1, 3, 0 pixels a frame. Here a
+ * message-only window on a high-priority thread takes each report as it
+ * comes (RIDEV_INPUTSINK, kept only while the game's window is in front),
+ * so the counts build up evenly and every read gets the motion since the
+ * last one, as BLACK's port reads them. */
+static HWND s_sink;
+static HWND s_sink_game;
+
+static LRESULT CALLBACK sink_proc(HWND h, UINT msg, WPARAM w, LPARAM l)
+{
+    if (msg == WM_INPUT) {
+        HWND g = __atomic_load_n(&s_sink_game, __ATOMIC_ACQUIRE);
+        if (LOAD(&s_applied) && g && GetForegroundWindow() == g)
+            raw_input(g, (HRAWINPUT)l);
+    }
+    return DefWindowProcA(h, msg, w, l);
+}
+
+static DWORD WINAPI sink_main(LPVOID ready)
+{
+    WNDCLASSA wc;
+    MSG m;
+
+    memset(&wc, 0, sizeof wc);
+    wc.lpfnWndProc = sink_proc;
+    wc.hInstance = GetModuleHandleA(NULL);
+    wc.lpszClassName = "xboxrecomp_raw_mouse";
+    RegisterClassA(&wc);
+    s_sink = CreateWindowExA(0, wc.lpszClassName, "", 0, 0, 0, 0, 0, HWND_MESSAGE, NULL,
+                             wc.hInstance, NULL);
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST);
+    SetEvent((HANDLE)ready);
+    if (!s_sink)
+        return 0;
+    while (GetMessageA(&m, NULL, 0, 0) > 0)
+        DispatchMessageA(&m);
+    return 0;
+}
+
+/* The sink's window, started on first use; NULL when it could not be made
+ * (raw input then goes to the game's window as before). */
+static HWND sink_window(void)
+{
+    static int tried;
+    if (!tried) {
+        HANDLE ready = CreateEventA(NULL, TRUE, FALSE, NULL), t;
+        tried = 1;
+        if (ready && (t = CreateThread(NULL, 0, sink_main, ready, 0, NULL)) != NULL) {
+            WaitForSingleObject(ready, 2000);
+            CloseHandle(t);
+        }
+        if (ready)
+            CloseHandle(ready);
+        fprintf(stderr, "[INPUT] mouse: raw input %s\n",
+                s_sink ? "on its own thread" : "on the window's thread");
+        fflush(stderr);
+    }
+    return s_sink;
+}
+
 void xbox_InputMouseWin32Sync(void *hwnd)
 {
     HWND h = (HWND)hwnd;
@@ -749,6 +813,11 @@ void xbox_InputMouseWin32Sync(void *hwnd)
             ;
         rid.dwFlags = 0;
         rid.hwndTarget = h;
+        if (sink_window()) {
+            __atomic_store_n(&s_sink_game, h, __ATOMIC_RELEASE);
+            rid.dwFlags = RIDEV_INPUTSINK;
+            rid.hwndTarget = s_sink;
+        }
         RegisterRawInputDevices(&rid, 1, sizeof rid);
         s_raw_seen = 0;
         s_moves = 0;
-- 

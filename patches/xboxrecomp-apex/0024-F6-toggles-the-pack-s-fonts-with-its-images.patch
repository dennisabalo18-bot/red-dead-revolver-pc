From f49c9579bca8e3b9199785a17aef5556f6ca75c4 Mon Sep 17 00:00:00 2001
From: rdr-port <rdr-port@users.noreply.github.com>
Date: Mon, 2 Nov 2026 00:42:10 -0300
Subject: [PATCH 24/47] F6 toggles the pack's fonts with its images

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d/nv2a_pb_d3d11.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/d3d/nv2a_pb_d3d11.c b/src/d3d/nv2a_pb_d3d11.c
index 455cb89..bc3b34e 100644
--- a/src/d3d/nv2a_pb_d3d11.c
+++ b/src/d3d/nv2a_pb_d3d11.c
@@ -356,10 +356,13 @@ static LRESULT CALLBACK wnd_proc(HWND h, UINT m, WPARAM w, LPARAM l)
             nv2a_pb_mlog_request();
             return 0;
         }
-        /* F6: the texture pack's images off and on, to see the difference
-         * at once (the F2 row "Texturas mejoradas" shows the same). */
+        /* F6: the texture pack's images and fonts off and on together, to
+         * see the difference at once (the F2 row "Texturas mejoradas" shows
+         * the same). */
         if (w == VK_F6 && nv2a_tex_pack_count()) {
-            nv2a_tex_pack_set_kind_enabled(XRTP_KIND_ART, !nv2a_tex_pack_kind_enabled(XRTP_KIND_ART));
+            int on = !nv2a_tex_pack_kind_enabled(XRTP_KIND_ART);
+            nv2a_tex_pack_set_kind_enabled(XRTP_KIND_ART, on);
+            nv2a_tex_pack_set_kind_enabled(XRTP_KIND_FONT, on);
             return 0;
         }
         /* Ctrl+F8: game speed x1 -> x2 -> x4 -> x1 (kernel_pacing.h). F8 alone

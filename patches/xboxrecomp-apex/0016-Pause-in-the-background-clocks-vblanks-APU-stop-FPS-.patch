     uint64_t due;
 
     *restarted_late_ns = 0;
+    if (xbox_Paused()) {
+        /* No vblank while paused; the speed change at resume restarts the grid. */
+        *next_due_ns = now_ns + 10000000ull;
+        return 0;
+    }
     if (!s->started || s->speed_gen != __atomic_load_n(&s_speed_gen, __ATOMIC_ACQUIRE)) {
         /* A speed change starts a new grid at the new rate from now. */
         s->speed_gen = __atomic_load_n(&s_speed_gen, __ATOMIC_ACQUIRE);

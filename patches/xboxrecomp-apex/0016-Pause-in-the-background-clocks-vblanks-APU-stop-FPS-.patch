+    if (!s_back || s_menu_failed || !(px = xbox_MenuPixels(s_back_h, &w, &h, &gen, &corner)))
         return;
     if (!blit_init())
         return;
@@ -4689,6 +4722,8 @@ static void menu_present(void)
     vp.Height = (float)h * k;
     vp.TopLeftX = ((float)s_back_w - vp.Width) * 0.5f;
     vp.TopLeftY = ((float)s_back_h - vp.Height) * 0.5f;
+    if (corner)                             /* the FPS box */
+        vp.TopLeftX = vp.TopLeftY = (float)(s_back_h / 60u);
     vp.MinDepth = 0.0f;
     vp.MaxDepth = 1.0f;
     ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 1, &s_back_rtv, NULL);
@@ -5293,6 +5328,19 @@ static void d3d11_flip(uint32_t surface_offset, uint32_t pitch)
     if (!init())
         return;
     pump();
+    /* rdr-port: paused in the background. The guest's clocks, vblanks and
+     * sound stop (xbox_PauseSet) and this flip waits, pumping the window,
+     * until it is in front again; the last frame stays on screen. */
+    if (s_unfocused && nv2a_d3d11_pause_focus(-1)) {
+        xbox_PauseSet(1);
+        fprintf(stderr, LOGP "paused (window in the background)\n");
+        while (s_unfocused && nv2a_d3d11_pause_focus(-1)) {
+            Sleep(15);
+            pump();
+        }
+        xbox_PauseSet(0);
+        fprintf(stderr, LOGP "resumed\n");
+    }
     {
         wchar_t tb[192];
         if (xbox_FramebufferWindowTitleText(tb, 192, &s_title_clock))
diff --git a/src/kernel/kernel_pacing.c b/src/kernel/kernel_pacing.c
index 16bee65..8490532 100644
--- a/src/kernel/kernel_pacing.c
+++ b/src/kernel/kernel_pacing.c
@@ -55,14 +55,13 @@ unsigned xbox_Speed(void)
     return __atomic_load_n(&s_warp_cur, __ATOMIC_ACQUIRE)->speed;
 }
 
-void xbox_SpeedSet(unsigned speed)
+/* Speed 0 is the pause: the clocks stand still. */
+static void speed_publish(unsigned speed)
 {
     SpeedWarp *o = __atomic_load_n(&s_warp_cur, __ATOMIC_ACQUIRE);
     SpeedWarp *n = o == &s_warp[0] ? &s_warp[1] : &s_warp[0];
     LARGE_INTEGER now;
 
-    if (speed < 1)
-        speed = 1;
     if (speed == o->speed)
         return;
     QueryPerformanceCounter(&now);
@@ -73,6 +72,35 @@ void xbox_SpeedSet(unsigned speed)
     __atomic_add_fetch(&s_speed_gen, 1u, __ATOMIC_RELEASE);
 }
 
+static volatile unsigned s_paused_speed;    /* the speed to resume at; 0 = running */
+
+void xbox_SpeedSet(unsigned speed)
+{
+    if (speed < 1)
+        speed = 1;
+    if (s_paused_speed)
+        s_paused_speed = speed;               /* applies on resume */
+    else
+        speed_publish(speed);
+}
+
+void xbox_PauseSet(int on)
+{
+    if (on && !s_paused_speed) {
+        s_paused_speed = xbox_Speed();
+        speed_publish(0);
+    } else if (!on && s_paused_speed) {
+        unsigned s = s_paused_speed;
+        s_paused_speed = 0;
+        speed_publish(s);
+    }
+}
+
+int xbox_Paused(void)
+{
+    return s_paused_speed != 0;
+}
+
 /* ── The vblank schedule ─────────────────────────────────── */
 

-const uint32_t *xbox_MenuPixels(unsigned back_h, unsigned *w, unsigned *h, unsigned *gen)
+/* The FPS box: presents a second, counted over half a second (the D3D11
+ * backend asks once a present). Redrawn only when the number moves. */
+static const uint32_t *fps_pixels(unsigned back_h, unsigned *w, unsigned *h, unsigned *gen)
+{
+    static LARGE_INTEGER freq, t0;
+    static unsigned frames, shown = ~0u, fps;
+    LARGE_INTEGER now;
+    unsigned fpx, W, H;
+    char v[32];
+    int i;
+
+    QueryPerformanceCounter(&now);
+    if (!freq.QuadPart) {
+        QueryPerformanceFrequency(&freq);
+        t0 = now;
+    }
+    frames++;
+    if (now.QuadPart - t0.QuadPart >= freq.QuadPart / 2) {
+        fps = (unsigned)((double)frames * (double)freq.QuadPart / (double)(now.QuadPart - t0.QuadPart) + 0.5);
+        frames = 0;
+        t0 = now;
+    }
+    fpx = back_h / 40u;
+    if (fpx < 13u) fpx = 13u;
+    if (fpx > 40u) fpx = 40u;
+    W = fpx * 9u / 2u;
+    H = fpx * 3u / 2u;
+    if (s_px && fps == shown && W == s_w && H == s_h)
+        goto out;
+    if (!make_surface(W, H, fpx))
+        return NULL;
+    shown = fps;
+    s_sig = 0;                              /* the menu redraws when it opens */
+    fill(0, 0, (int)W, (int)H, RGB(18, 14, 12));
+    SelectObject(s_dc, s_font_big);
+    snprintf(v, sizeof v, "%u FPS", fps);
+    text(0, 0, (int)W, (int)H, v, DT_CENTER,
+         fps >= 55 ? RGB(150, 220, 120) : fps >= 30 ? RGB(235, 195, 125) : RGB(235, 110, 90));
+    GdiFlush();
+    for (i = 0; i < (int)(W * H); i++)
+        s_px[i] = (s_px[i] & 0x00FFFFFFu) | 0xB4000000u;
+    s_gen++;
+out:
+    *w = s_w;
+    *h = s_h;
+    *gen = s_gen;
+    return s_px;
+}
+
+const uint32_t *xbox_MenuPixels(unsigned back_h, unsigned *w, unsigned *h, unsigned *gen,
+                                int *corner)
 {
     unsigned fpx, row, pad, W, H, sig = 2166136261u;
     int i, y;
 
-    if (!s_open)
-        return NULL;
+    *corner = 0;
+    if (!s_open) {
+        if (!s_fps_on)
+            return NULL;
+        *corner = 1;
+        return fps_pixels(back_h, w, h, gen);
+    }
     fpx = back_h / 42u;
     if (fpx < 13u) fpx = 13u;
     if (fpx > 40u) fpx = 40u;

+/* rdr-port, the F2 menu: pause in the background, and vsync. */
+int nv2a_d3d11_pause_focus(int set)
+{
+    if (s_pause_focus < 0) {
+        const char *e = getenv("RECOMP_PAUSE_UNFOCUSED");
+        s_pause_focus = !(e && *e == '0');
+    }
+    if (set >= 0)
+        s_pause_focus = set != 0;
+    return s_pause_focus;
+}
+
+int nv2a_d3d11_vsync(int set)
+{
+    if (set >= 0) {
+        s_sync_interval = set != 0;
+        s_vsync_set = 1;
+    }
+    return s_sync_interval != 0;
+}

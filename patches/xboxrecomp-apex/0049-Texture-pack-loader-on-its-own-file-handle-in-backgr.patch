From 4824867fd5f38b3b0790cbbf63aed5d4d856563e Mon Sep 17 00:00:00 2001
From: rdr-port <rdr-port@users.noreply.github.com>
Date: Wed, 4 Nov 2026 14:34:40 -0300
Subject: [PATCH] Texture pack: loader on its own file handle in background I/O
 mode; F2 changes logged

On a hard disk the loader's reads held up the frame (shared handle and
lock) and the game's own streaming (same disk, same priority). Now the
frame's reads use their own handle and the loader runs in
THREAD_MODE_BACKGROUND_BEGIN (low disk priority). Every F2 change and the
menu opening and closing go to the log.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d/host_menu.c        |  5 +++++
 src/kernel/nv2a_tex_pack.c | 39 ++++++++++++++++++++++++++------------
 2 files changed, 32 insertions(+), 12 deletions(-)

diff --git a/src/d3d/host_menu.c b/src/d3d/host_menu.c
index de52ce2..99dcb98 100644
--- a/src/d3d/host_menu.c
+++ b/src/d3d/host_menu.c
@@ -282,6 +282,9 @@ static void change(int d)
         c = 0;
     c = (c + d + n) % n;
     it->set(c);
+    /* rdr-port: in the log, so a report says what was touched before a problem. */
+    fprintf(stderr, "[MENU] %s = %s\n", it->key ? it->key : it->label, it->choices[c]);
+    fflush(stderr);
     save();
 }
 
@@ -295,6 +298,8 @@ static void open_menu(int on)
      * it is up, so the mouse turns nothing. */
     xbox_InputKeysClear();
     xbox_InputMouseSuspend(on);
+    fprintf(stderr, "[MENU] %s\n", on ? "abierto" : "cerrado");
+    fflush(stderr);
 }
 
 int xbox_MenuKey(int vk, int down, int repeat)
diff --git a/src/kernel/nv2a_tex_pack.c b/src/kernel/nv2a_tex_pack.c
index ad35d44..7383ca6 100644
--- a/src/kernel/nv2a_tex_pack.c
+++ b/src/kernel/nv2a_tex_pack.c
@@ -119,7 +119,10 @@ static void fail(char *err, size_t errlen, const char *msg)
 
 static void loader_start(void);
 static void loader_stop(void);
-static FILE *s_file;                 /* the pack, kept open */
+/* The pack, kept open: one handle for the reads made on the spot (the
+ * upload's thread) and one for the loader thread's alone, so the frame never
+ * waits behind a background read on a slow disk. */
+static FILE *s_file, *s_file_bg;
 static atomic_ullong s_loaded_bytes; /* texels held in memory */
 
 void nv2a_tex_pack_unload(void)
@@ -130,6 +133,10 @@ void nv2a_tex_pack_unload(void)
         fclose(s_file);
         s_file = NULL;
     }
+    if (s_file_bg) {
+        fclose(s_file_bg);
+        s_file_bg = NULL;
+    }
     atomic_store(&s_loaded_bytes, 0);
     for (i = 0; i < s_count; i++)
         free(s_entries[i].data);
@@ -519,18 +526,21 @@ static int claim(struct nv2a_tex_pack_entry *e, int from)
 }
 
 /* Reads e's payload; NULL on failure (the entry goes back to not read). */
-static uint32_t *read_entry(struct nv2a_tex_pack_entry *e)
+static uint32_t *read_entry(struct nv2a_tex_pack_entry *e, int bg)
 {
     /* bytes is a multiple of 4 either way: texels * 4, or 16 per block. */
     uint32_t *data = (uint32_t *)malloc(e->bytes);
     int ok = 0;
     if (data) {
-        io_lock();
-        if (!s_file && s_path)
-            s_file = fopen(s_path, "rb");
-        ok = s_file && pack_seek(s_file, e->offset) == 0
-             && fread(data, 1u, e->bytes, s_file) == e->bytes;
-        io_unlock();
+        FILE **fp = bg ? &s_file_bg : &s_file;
+        if (!bg)
+            io_lock();
+        if (!*fp && s_path)
+            *fp = fopen(s_path, "rb");
+        ok = *fp && pack_seek(*fp, e->offset) == 0
+             && fread(data, 1u, e->bytes, *fp) == e->bytes;
+        if (!bg)
+            io_unlock();
     }
     if (!ok) {
         /* Said for the first four failures only: the guest texels are
@@ -586,7 +596,7 @@ const uint32_t *nv2a_tex_pack_texels(struct nv2a_tex_pack_entry *e)
             relax(&n);
         d = state(e) == ST_READY ? e->data : NULL;
     } else {
-        d = read_entry(e);
+        d = read_entry(e, 0);
     }
     us = (unsigned long long)(now_us() - t0);
     atomic_fetch_add(&s_st_sync_n, 1u);
@@ -705,7 +715,12 @@ static DWORD WINAPI loader_main(LPVOID unused)
 {
     long long saved = now_ms();
     (void)unused;
-    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    /* Background mode: low CPU and, above all, low disk priority. On a hard
+     * disk the game's own streaming (stream*.dat, the level files) waited
+     * behind the pack's reads after "Texturas mejoradas" was turned on, and
+     * the game stopped answering until they were done. */
+    if (!SetThreadPriority(GetCurrentThread(), THREAD_MODE_BACKGROUND_BEGIN))
+        SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
     while (!s_loader_stop) {
         struct nv2a_tex_pack_entry *e;
         int idle = 1;
@@ -715,7 +730,7 @@ static DWORD WINAPI loader_main(LPVOID unused)
             if (!claim(e, ST_QUEUED))
                 continue;           /* the flip read it itself meanwhile */
             t0 = now_us();
-            read_entry(e);
+            read_entry(e, 1);
             atomic_fetch_add(&s_st_async_n, 1u);
             atomic_fetch_add(&s_st_async_us, (unsigned long long)(now_us() - t0));
         }
@@ -727,7 +742,7 @@ static DWORD WINAPI loader_main(LPVOID unused)
         if (s_pre_next < s_pre_n && atomic_load(&s_loaded_bytes) < s_budget / 4 * 3) {
             e = find_hash(s_pre[s_pre_next++]);
             if (e && claim(e, ST_NONE)) {
-                read_entry(e);
+                read_entry(e, 1);
                 atomic_fetch_add(&s_st_pre, 1u);
             }
             Sleep(2);              /* gently: the game's own reads come first */
-- 
2.55.0.windows.3


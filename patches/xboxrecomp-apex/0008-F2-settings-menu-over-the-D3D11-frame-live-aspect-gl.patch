diff --git a/src/d3d/host_menu.c b/src/d3d/host_menu.c
new file mode 100644
index 0000000..1a490eb
--- /dev/null
+++ b/src/d3d/host_menu.c
@@ -0,0 +1,457 @@
+/*
+ * host_menu.c - the F2 settings menu; see host_menu.h.
+ *
+ * The panel is drawn with GDI into a top-down DIB, only when what it shows
+ * moved (a signature of the selection, every row's choice and the size), and
+ * nv2a_pb_d3d11.c uploads it and blends it over the back buffer before the
+ * present. Keys and the draw both run on the window's thread (the flip pumps
+ * the window), so the menu's own state needs no lock; a row's get and set
+ * only touch values other threads read whole.
+ */
+#include "host_menu.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <windows.h>
+
+#include "nv2a_backend_common.h"
+#include "kernel_pacing.h"
+#include "input/keyboard.h"
+#include "input/mouse.h"
+
+#define ITEMS_MAX 64
+
+static const xbox_menu_item *s_items[ITEMS_MAX];
+static int  s_n, s_sel = -1, s_open, s_loading;
+static char s_path[MAX_PATH];
+
+/* ---- the runtime's rows ------------------------------------------------- */
+
+static const char *const k_scale[] = {
+    "x1 (640x480)", "x2 (1280x960)", "x3 (1920x1440)", "x4 (2560x1920)", NULL
+};
+static int get_scale(void) { return (int)nv2a_host_render_scale() - 1; }
+static void set_scale(int i)
+{
+    struct nv2a_host_opts o = *nv2a_host_opts();
+    o.render_scale = (unsigned)i + 1u;
+    nv2a_host_opts_request(&o, NV2A_OPT_SCALE);
+}
+
+static const char *const k_aspect[] = { "4:3 (original)", "16:9", "16:10", "21:9", NULL };
+static const unsigned k_aspect_wh[][2] = { {0, 0}, {16, 9}, {16, 10}, {21, 9} };
+static int get_aspect(void)
+{
+    const struct nv2a_host_opts *o = nv2a_host_opts();
+    int i;
+    for (i = 1; i < 4; i++)
+        if (o->aspect_w * k_aspect_wh[i][1] == o->aspect_h * k_aspect_wh[i][0] && o->aspect_w)
+            return i;
+    return 0;
+}
+static void set_aspect(int i)
+{
+    struct nv2a_host_opts o = *nv2a_host_opts();
+    o.aspect_w = k_aspect_wh[i][0];
+    o.aspect_h = k_aspect_wh[i][1];
+    nv2a_host_opts_request(&o, NV2A_OPT_ASPECT);
+}
+
+static const char *const k_window[] = {
+    "Libre", "640x480", "800x600", "960x720", "1024x768", "1280x720", "1280x960",
+    "1366x768", "1440x1080", "1600x900", "1600x1200", "1920x1080", "2560x1080",
+    "2560x1440", "3840x2160", NULL
+};
+static int s_window;
+static void set_full(int i);
+static int get_window(void) { return s_window; }
+static void set_window(int i)
+{
+    unsigned w, h;
+    s_window = i;
+    if (i <= 0 || sscanf(k_window[i], "%ux%u", &w, &h) != 2)
+        return;
+    nv2a_d3d11_window_request(w, h);
+    /* Picked in the menu while fullscreen: back to the window to show it. */
+    if (!s_loading && nv2a_host_opts()->fullscreen)
+        set_full(0);
+}
+
+static const char *const k_onoff[] = { "No", "Sí", NULL };
+static int get_full(void) { return nv2a_host_opts()->fullscreen != 0; }
+static void set_full(int i)
+{
+    struct nv2a_host_opts o = *nv2a_host_opts();
+    o.fullscreen = i;
+    nv2a_host_opts_request(&o, NV2A_OPT_FULLSCREEN);
+}
+
+static const char *const k_filter[] = { "Nítido", "Suave", "Entero", NULL };
+static int get_filter(void)
+{
+    int f = nv2a_host_opts()->present_filter;
+    return f >= 0 && f <= 2 ? f : 0;
+}
+static void set_filter(int i)
+{
+    struct nv2a_host_opts o = *nv2a_host_opts();
+    o.present_filter = i;
+    nv2a_host_opts_request(&o, NV2A_OPT_FILTER);
+}
+
+static const char *const k_aniso[] = { "No", "x2", "x4", "x8", "x16", NULL };
+static const unsigned k_aniso_v[] = { 0, 2, 4, 8, 16 };
+static int get_aniso(void)
+{
+    unsigned a = nv2a_host_opts()->aniso;
+    int i;
+    for (i = 4; i > 0; i--)
+        if (a >= k_aniso_v[i])
+            return i;
+    return 0;
+}
+static void set_aniso(int i)
+{
+    struct nv2a_host_opts o = *nv2a_host_opts();
+    o.aniso = k_aniso_v[i];
+    nv2a_host_opts_request(&o, NV2A_OPT_ANISO);
+}
+
+static const char *const k_snap[] = { "No", "Sí", NULL };
+static int get_snap(void) { return nv2a_host_opts()->snap_2d != 0; }
+static void set_snap(int i)
+{
+    struct nv2a_host_opts o = *nv2a_host_opts();
+    o.snap_2d = i;
+    nv2a_host_opts_request(&o, NV2A_OPT_SNAP2D);
+}
+
+static const char *const k_glow[] = { "Sí (original)", "No (sin costura)", NULL };
+static int get_glow(void) { return nv2a_d3d11_glow_off(-1) != 0; }
+static void set_glow(int i) { nv2a_d3d11_glow_off(i); }
+
+static const char *const k_speed[] = { "x1", "x2 (F8)", NULL };
+static int get_speed(void) { return xbox_Speed() > 1; }
+static void set_speed(int i) { xbox_SpeedSet(i ? 2u : 1u); }
+
+static const xbox_menu_item k_builtin[] = {
+    { NULL, "Gráficos", NULL, NULL, NULL },
+    { "render_scale", "Resolución interna", k_scale, get_scale, set_scale },
+    { "aspect", "Relación de aspecto", k_aspect, get_aspect, set_aspect },
+    { "window", "Tamaño de ventana", k_window, get_window, set_window },
+    { "fullscreen", "Pantalla completa (F11)", k_onoff, get_full, set_full },
+    { "filter", "Filtro de escalado", k_filter, get_filter, set_filter },
+    { "aniso", "Filtrado anisotrópico", k_aniso, get_aniso, set_aniso },
+    { "snap_2d", "HUD alineado a píxel", k_snap, get_snap, set_snap },
+    { "glow", "Brillo a pantalla completa", k_glow, get_glow, set_glow },
+    { NULL, "Juego", NULL, NULL, NULL },
+    { NULL, "Velocidad", k_speed, get_speed, set_speed },
+};
+
+static void builtin(void)
+{
+    static int done;
+    size_t i;
+    if (done)
+        return;
+    done = 1;
+    for (i = 0; i < sizeof k_builtin / sizeof k_builtin[0]; i++)
+        s_items[s_n++] = &k_builtin[i];
+}
+
+void xbox_MenuAdd(const xbox_menu_item *it)
+{
+    builtin();
+    if (it && s_n < ITEMS_MAX)
+        s_items[s_n++] = it;
+}
+
+static int choice_count(const xbox_menu_item *it)
+{
+    int n = 0;
+    while (it->choices && it->choices[n])
+        n++;
+    return n;
+}
+
+static void save(void)
+{
+    FILE *f;
+    int i;
+    if (!s_path[0] || s_loading || !(f = fopen(s_path, "w")))
+        return;
+    fprintf(f, "# Ajustes del menú F2 (se reescribe solo). Borra el archivo para volver a env.bat.\n");
+    for (i = 0; i < s_n; i++) {
+        const xbox_menu_item *it = s_items[i];
+        int c;
+        if (!it->key || !it->choices)
+            continue;
+        c = it->get();
+        if (c >= 0 && c < choice_count(it))
+            fprintf(f, "%s=%s\n", it->key, it->choices[c]);
+    }
+    fclose(f);
+}
+
+void xbox_MenuLoad(const char *path)
+{
+    char line[256];
+    FILE *f;
+
+    builtin();
+    snprintf(s_path, sizeof s_path, "%s", path ? path : "");
+    if (!s_path[0] || !(f = fopen(s_path, "r")))
+        return;
+    s_loading = 1;
+    while (fgets(line, sizeof line, f)) {
+        char *eq = strchr(line, '='), *v;
+        int i, c;
+        if (line[0] == '#' || !eq)
+            continue;
+        *eq = 0;
+        v = eq + 1;
+        v[strcspn(v, "\r\n")] = 0;
+        for (i = 0; i < s_n; i++) {
+            const xbox_menu_item *it = s_items[i];
+            if (!it->key || !it->choices || strcmp(it->key, line))
+                continue;
+            for (c = 0; it->choices[c]; c++)
+                if (!strcmp(it->choices[c], v)) {
+                    it->set(c);
+                    break;
+                }
+        }
+    }
+    s_loading = 0;
+    fclose(f);
+    fprintf(stderr, "[MENU] settings from %s\n", s_path);
+}
+
+int xbox_MenuIsOpen(void)
+{
+    return s_open;
+}
+
+/* ---- keys ----------------------------------------------------------------- */
+
+static void move_sel(int d)
+{
+    int i, k = s_sel;
+    for (i = 0; i < s_n; i++) {
+        k = (k + d + s_n) % s_n;
+        if (s_items[k]->choices) {
+            s_sel = k;
+            return;
+        }
+    }
+}
+
+static void change(int d)
+{
+    const xbox_menu_item *it;
+    int n, c;
+    if (s_sel < 0 || s_sel >= s_n || !(it = s_items[s_sel])->choices)
+        return;
+    n = choice_count(it);
+    if (n <= 0)
+        return;
+    c = it->get();
+    if (c < 0 || c >= n)
+        c = 0;
+    c = (c + d + n) % n;
+    it->set(c);
+    save();
+}
+
+static void open_menu(int on)
+{
+    builtin();
+    s_open = on;
+    if (on && s_sel < 0)
+        move_sel(1);
+    /* Nothing held into the menu or out of it; the cursor is free while
+     * it is up, so the mouse turns nothing. */
+    xbox_InputKeysClear();
+    xbox_InputMouseSuspend(on);
+}
+
+int xbox_MenuKey(int vk, int down, int repeat)
+{
+    if (!s_open) {
+        if (vk == VK_F2 && down && !repeat) {
+            open_menu(1);
+            return 1;
+        }
+        return 0;
+    }
+    /* The host's own keys still work with the menu up. */
+    if (vk == VK_F8 || vk == VK_F10 || vk == VK_F11)
+        return 0;
+    if (!down)
+        return 1;
+    switch (vk) {
+    case VK_F2:
+    case VK_ESCAPE:
+        if (!repeat)
+            open_menu(0);
+        break;
+    case VK_UP:    move_sel(-1); break;
+    case VK_DOWN:  move_sel(1); break;
+    case VK_LEFT:  change(-1); break;
+    case VK_RIGHT:
+    case VK_RETURN:
+    case VK_SPACE: change(1); break;
+    }
+    return 1;
+}
+
+/* ---- the panel ------------------------------------------------------------ */
+
+static HDC      s_dc;
+static HBITMAP  s_bmp;
+static uint32_t *s_px;
+static unsigned s_w, s_h, s_gen;
+static HFONT    s_font, s_font_big, s_font_small;
+static unsigned s_font_px, s_sig;
+
+static void text(int x, int y, int w, int h, const char *utf8, UINT fmt, COLORREF col)
+{
+    wchar_t wb[160];
+    RECT r;
+    if (!MultiByteToWideChar(CP_UTF8, 0, utf8, -1, wb, 160))
+        return;
+    r.left = x;
+    r.top = y;
+    r.right = x + w;
+    r.bottom = y + h;
+    SetTextColor(s_dc, col);
+    DrawTextW(s_dc, wb, -1, &r, fmt | DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX);
+}
+
+static void fill(int x, int y, int w, int h, COLORREF col)
+{
+    RECT r;
+    HBRUSH b = CreateSolidBrush(col);
+    r.left = x;
+    r.top = y;
+    r.right = x + w;
+    r.bottom = y + h;
+    FillRect(s_dc, &r, b);
+    DeleteObject(b);
+}
+
+static HFONT font(int px, int weight)
+{
+    return CreateFontW(-px, 0, 0, 0, weight, 0, 0, 0, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS,
+                       CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY, DEFAULT_PITCH, L"Segoe UI");
+}
+
+static int make_surface(unsigned w, unsigned h, unsigned fpx)
+{
+    BITMAPINFO bi;
+    void *bits = NULL;
+
+    if (!s_dc && !(s_dc = CreateCompatibleDC(NULL)))
+        return 0;
+    if (fpx != s_font_px) {
+        if (s_font) DeleteObject(s_font);
+        if (s_font_big) DeleteObject(s_font_big);
+        if (s_font_small) DeleteObject(s_font_small);
+        s_font = font((int)fpx, FW_NORMAL);
+        s_font_big = font((int)(fpx * 13 / 10), FW_BOLD);
+        s_font_small = font((int)(fpx * 8 / 10), FW_SEMIBOLD);
+        s_font_px = fpx;
+    }
+    if (s_bmp && w == s_w && h == s_h)
+        return 1;
+    if (s_bmp)
+        DeleteObject(s_bmp);
+    memset(&bi, 0, sizeof bi);
+    bi.bmiHeader.biSize = sizeof bi.bmiHeader;
+    bi.bmiHeader.biWidth = (LONG)w;
+    bi.bmiHeader.biHeight = -(LONG)h;      /* top-down */
+    bi.bmiHeader.biPlanes = 1;
+    bi.bmiHeader.biBitCount = 32;
+    bi.bmiHeader.biCompression = BI_RGB;
+    s_bmp = CreateDIBSection(s_dc, &bi, DIB_RGB_COLORS, &bits, NULL, 0);
+    if (!s_bmp)
+        return 0;
+    SelectObject(s_dc, s_bmp);
+    SetBkMode(s_dc, TRANSPARENT);
+    s_px = (uint32_t *)bits;
+    s_w = w;
+    s_h = h;
+    return 1;
+}
+
+const uint32_t *xbox_MenuPixels(unsigned back_h, unsigned *w, unsigned *h, unsigned *gen)
+{
+    unsigned fpx, row, pad, W, H, sig = 2166136261u;
+    int i, y;
+
+    if (!s_open)
+        return NULL;
+    fpx = back_h / 42u;
+    if (fpx < 13u) fpx = 13u;
+    if (fpx > 40u) fpx = 40u;
+    row = fpx * 17u / 10u;
+    pad = fpx;
+    W = fpx * 30u;
+    H = pad * 2u + row * 2u + (unsigned)s_n * row + row * 3u / 2u;
+
+    /* Redraw only when something shown moved. */
+    sig = (sig ^ fpx) * 16777619u;
+    sig = (sig ^ (unsigned)s_sel) * 16777619u;
+    for (i = 0; i < s_n; i++)
+        sig = (sig ^ (unsigned)(s_items[i]->choices ? s_items[i]->get() + 1 : 0)) * 16777619u;
+    if (s_px && sig == s_sig && W == s_w && H == s_h)
+        goto out;
+    if (!make_surface(W, H, fpx))
+        return NULL;
+    s_sig = sig;
+
+    fill(0, 0, (int)W, (int)H, RGB(18, 14, 12));
+    fill(0, 0, (int)W, 3, RGB(170, 70, 40));
+    SelectObject(s_dc, s_font_big);
+    text((int)pad, (int)pad, (int)(W - 2 * pad), (int)row, "AJUSTES", DT_LEFT, RGB(235, 195, 125));
+    SelectObject(s_dc, s_font_small);
+    text((int)pad, (int)pad, (int)(W - 2 * pad), (int)row, "F2 / Esc: cerrar", DT_RIGHT,
+         RGB(150, 140, 130));
+    y = (int)(pad + row + row / 2);
+    for (i = 0; i < s_n; i++, y += (int)row) {
+        const xbox_menu_item *it = s_items[i];
+        if (!it->choices) {
+            SelectObject(s_dc, s_font_small);
+            text((int)pad, y, (int)(W - 2 * pad), (int)row, it->label, DT_LEFT | DT_BOTTOM,
+                 RGB(200, 110, 70));
+            fill((int)pad, y + (int)row - 2, (int)(W - 2 * pad), 1, RGB(90, 50, 35));
+            continue;
+        }
+        if (i == s_sel)
+            fill((int)pad / 2, y + 1, (int)(W - pad), (int)row - 2, RGB(125, 38, 26));
+        SelectObject(s_dc, s_font);
+        text((int)pad, y, (int)(W - 2 * pad), (int)row, it->label, DT_LEFT,
+             i == s_sel ? RGB(255, 255, 255) : RGB(215, 210, 200));
+        {
+            char v[128];
+            int c = it->get(), n = choice_count(it);
+            snprintf(v, sizeof v, "‹  %s  ›", c >= 0 && c < n ? it->choices[c] : "?");
+            text((int)pad, y, (int)(W - 2 * pad), (int)row, v, DT_RIGHT,
+                 i == s_sel ? RGB(255, 225, 150) : RGB(225, 185, 120));
+        }
+    }
+    SelectObject(s_dc, s_font_small);
+    text((int)pad, y + (int)row / 4, (int)(W - 2 * pad), (int)row,
+         "↑↓ elegir   ←→ cambiar   (se guarda solo)", DT_LEFT, RGB(150, 140, 130));
+    GdiFlush();
+    /* GDI leaves alpha at 0: the whole panel at 92%. */
+    for (i = 0; i < (int)(W * H); i++)
+        s_px[i] = (s_px[i] & 0x00FFFFFFu) | 0xEB000000u;
+    s_gen++;
+out:
+    *w = s_w;
+    *h = s_h;
+    *gen = s_gen;
+    return s_px;
+}
diff --git a/src/d3d/host_menu.h b/src/d3d/host_menu.h
new file mode 100644
index 0000000..16be522
--- /dev/null
+++ b/src/d3d/host_menu.h
@@ -0,0 +1,54 @@
+/*
+ * host_menu.h - the F2 settings menu, drawn over the presented frame by the
+ * D3D11 backend (nv2a_pb_d3d11.c).
+ *
+ * Every row is a list of choices. The runtime adds its own (render scale,
+ * aspect, window size, fullscreen, filter, aniso, game speed); a title adds
+ * its own with xbox_MenuAdd before xbox_MenuLoad. A change applies at once
+ * (render options at the next flip) and every row is saved to the file
+ * xbox_MenuLoad was given, as key=choice lines, and applied again from it at
+ * the next start.
+ *
+ * Keys while open: Up/Down pick a row, Left/Right (or Enter) change it,
+ * F2 or Esc close. The game gets no key or mouse input meanwhile.
+ */
+#ifndef XBOX_HOST_MENU_H
+#define XBOX_HOST_MENU_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct xbox_menu_item {
+    const char *key;               /* saved as key=choice; NULL: not saved */
+    const char *label;             /* UTF-8 */
+    const char *const *choices;    /* NULL-terminated, UTF-8; NULL: a section title */
+    int  (*get)(void);             /* the current choice's index */
+    void (*set)(int i);            /* apply choice i */
+} xbox_menu_item;
+
+/* Adds a row (the struct is kept by pointer: give it static storage). */
+void xbox_MenuAdd(const xbox_menu_item *it);
+/* Applies the choices saved in path and saves every later change there. */
+void xbox_MenuLoad(const char *path);
+int  xbox_MenuIsOpen(void);
+
+/* ---- the window's side (nv2a_pb_d3d11.c) ---- */
+/* A key edge from the window; 1 when the menu took it. */
+int  xbox_MenuKey(int vk, int down, int repeat);
+/* The panel for a back buffer h lines tall, as top-down BGRA with alpha;
+ * *gen moves whenever the pixels do. NULL while closed. */
+const uint32_t *xbox_MenuPixels(unsigned back_h, unsigned *w, unsigned *h, unsigned *gen);
+
+/* nv2a_pb_d3d11.c: resize the window's client area at the next flip. */
+void nv2a_d3d11_window_request(unsigned w, unsigned h);
+/* nv2a_pb_d3d11.c: the full-screen glow off (1) or on (0); -1 only reads. */
+int  nv2a_d3d11_glow_off(int set);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif

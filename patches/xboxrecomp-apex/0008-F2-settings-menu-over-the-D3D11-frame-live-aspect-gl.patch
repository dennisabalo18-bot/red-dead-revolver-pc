+/* rdr-port: the menu's window size (nv2a_d3d11_window_request), the client
+ * area set at the flip on this thread, which owns the window. While
+ * fullscreen it waits for the window to come back. */
+static volatile LONG s_win_req;
+static unsigned s_win_req_w, s_win_req_h;
+
+void nv2a_d3d11_window_request(unsigned w, unsigned h)
+{
+    s_win_req_w = w;
+    s_win_req_h = h;
+    InterlockedExchange(&s_win_req, 1);
+}
+
+static void window_apply(void)
+{
+    RECT r;
+    DWORD style;
+
+    if (!s_hwnd || !s_win_req)
+        return;
+    if (nv2a_host_opts()->fullscreen)
+        return;
+    InterlockedExchange(&s_win_req, 0);
+    if (IsZoomed(s_hwnd))
+        ShowWindow(s_hwnd, SW_RESTORE);
+    style = (DWORD)GetWindowLongPtrW(s_hwnd, GWL_STYLE);
+    r.left = r.top = 0;
+    r.right = (LONG)s_win_req_w;
+    r.bottom = (LONG)s_win_req_h;
+    AdjustWindowRect(&r, style, FALSE);
+    SetWindowPos(s_hwnd, NULL, 0, 0, r.right - r.left, r.bottom - r.top,
+                 SWP_NOMOVE | SWP_NOZORDER | SWP_NOOWNERZORDER);
+    fprintf(stderr, LOGP "window %ux%u (menu)\n", s_win_req_w, s_win_req_h);

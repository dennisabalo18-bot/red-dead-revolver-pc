From 38f6e5d4c19e986487852f760e1683410a6d0472 Mon Sep 17 00:00:00 2001
From: rdr-port <rdr-port@users.noreply.github.com>
Date: Sun, 1 Nov 2026 06:01:18 -0300
Subject: [PATCH 05/47] d3d11: RECOMP_D3D11_SKIP_RT=WxH drops batches laying a
 WxH target over a larger one

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d/nv2a_pb_d3d11.c | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/src/d3d/nv2a_pb_d3d11.c b/src/d3d/nv2a_pb_d3d11.c
index 03710c2..cbc78b0 100644
--- a/src/d3d/nv2a_pb_d3d11.c
+++ b/src/d3d/nv2a_pb_d3d11.c
@@ -3407,6 +3407,34 @@ static int aspect_flat(const struct nv2a_pb_draw *d, const struct nv2a_pb_vsh *v
     return 1;
 }
 
+/* RECOMP_D3D11_SKIP_RT=WxH: drop the batches that lay a W x H render
+ * target over a larger one, a title's full-screen glow or blur pass when
+ * it draws wrong. Red Dead Revolver's glow (a 512x256 copy of the frame
+ * fanned back over it at half alpha) left a seam through the screen's
+ * centre; 512x256 turns it off. The pass that fills the small target still
+ * runs, nothing reads it. Read after setup_pixel, which finds the stages'
+ * targets (s_stage_rt). */
+static int skip_rt_overlay(const RenderTarget *rt)
+{
+    static int w = -1, h;
+    int n;
+
+    if (w < 0) {
+        const char *e = getenv("RECOMP_D3D11_SKIP_RT");
+        if (!e || sscanf(e, "%dx%d", &w, &h) != 2 || w <= 0 || h <= 0)
+            w = 0;
+    }
+    if (!w)
+        return 0;
+    for (n = 0; n < 4; n++) {
+        const RenderTarget *src = s_stage_rt[n];
+        if (src && src != &s_self && src != rt && (int)src->w == w && (int)src->h == h
+                && rt->w > src->w)
+            return 1;
+    }
+    return 0;
+}
+
 /* The pixels->NDC mapping at b2 and the scissor for one placement
  * (nv2a_aspect_map, nv2a_aspect_box; with pad 0 both are stock). cb is
  * the surface clip (nv2a_draw_box). */
@@ -3823,6 +3851,11 @@ static void d3d11_on_draw(const struct nv2a_pb_draw *d)
                 s_sc.ps = ps;
             }
         }
+        if (skip_rt_overlay(rt)) {
+            s_cur = NULL;
+            s_draws_skipped++;
+            return;
+        }
         if (hp.place != NV2A_PLACE_CENTRE)
             s_draws_stretch++;
         if (hp.two_d && !have_x) {
-- 

diff --git a/src/d3d/nv2a_pb_d3d11.c b/src/d3d/nv2a_pb_d3d11.c
index e4ab7ce..2845b26 100644
--- a/src/d3d/nv2a_pb_d3d11.c
+++ b/src/d3d/nv2a_pb_d3d11.c
@@ -597,6 +597,21 @@ static const char s_vs_passthrough_src[] =
 
 static void create_black_texture(void);
 
+/* rdr-port: a widescreen TV reported to the title (xbox_VideoWidescreen,
+ * kernel.h): a title that then picks a 720x480 mode draws it anamorphic, for
+ * a 16:9 screen, as on the console. The present shows such a frame at 16:9
+ * (wide_frame) and the window starts 16:9. */
+static int wide_tv(void)
+{
+    extern int xbox_VideoWidescreen(void);
+    return xbox_VideoWidescreen();
+}
+
+static int wide_frame(const RenderTarget *rt)
+{
+    return rt && wide_tv() && rt->w == 720 && rt->h == 480;
+}
+
 static int init(void)
 {
     static int tried;
@@ -608,7 +623,7 @@ static int init(void)
     wchar_t title[192];
     /* display.aspect: a window of the padded frame's shape (854x480 at
      * 16:9), so the pads are on screen at 1:1. */
-    RECT r = {0, 0, (LONG)nv2a_host_window_w(640, 480, 1), 480};
+    RECT r = {0, 0, (LONG)(wide_tv() ? 854u : nv2a_host_window_w(640, 480, 1)), 480};
     int full = nv2a_host_opts()->fullscreen;
     int internal = nv2a_host_opts()->present_surface == NV2A_PRESENT_SURFACE_INTERNAL;
     UINT bw = (UINT)r.right, bh = 480;
@@ -3435,8 +3450,7 @@ static int aspect_flat(const struct nv2a_pb_draw *d, const struct nv2a_pb_vsh *v
  * frame into a 512x256 target and fans that back over the frame at half
  * alpha, which left a seam through the screen's centre. A target drawn
  * from a larger one is marked a copy of it (rt_copy_mark), and a batch
- * that lays such a copy back over the target it was copied from is
- * dropped. Targets drawn from textures (the menu's book, the posters) are
+ * that lays such a copy back over a larger target is dropped. Targets drawn from textures (the menu's book, the posters) are
  * no copy and keep drawing, which a size alone (the first version) could
  * not tell apart. RECOMP_D3D11_SKIP_RT=WxH turns it on at start for copies
  * of that size, =1 for any size; the F2 menu flips it live
@@ -3492,8 +3506,11 @@ static int skip_rt_overlay(const RenderTarget *rt)
         return 0;
     for (n = 0; n < 4; n++) {
         const RenderTarget *src = s_stage_rt[n];
-        if (src && src != &s_self && src != rt && src->copy_of == rt->offset
-                && rt->w > src->w
+        /* Any copy laid back over a larger target: the scene is drawn into
+         * its own 640x480 (not the frame) and composited, so the copy's
+         * source is not the target it lands on. */
+        if (src && src != &s_self && src != rt && src->copy_of
+                && rt->w > src->w && rt->h > src->h
                 && (!s_glow_w || ((int)src->w == s_glow_w && (int)src->h == s_glow_h)))
             return 1;
     }
@@ -4483,6 +4500,12 @@ static void present_blit(RenderTarget *rt, int filter, unsigned overscan, int in
     hcw = (cw + 2u * rt->pad) * rt->n;
     hch = ch * rt->n;
     nv2a_present_crop(hcw, hch, rt->hw, rt->hh, rt->n, rt->pad, overscan, filter, &c);
+    if (wide_frame(rt)) {
+        /* anamorphic 720x480: shown 16:9, scaled smoothly */
+        c.fit_w = (c.fit_h * 16u + 4u) / 9u;
+        if (filter == NV2A_PRESENT_INTEGER)
+            filter = NV2A_PRESENT_LINEAR;
+    }
     whole = nv2a_present_rect(c.fit_w, c.fit_h, s_back_w, s_back_h, filter, &r);
     if (overscan && internal) {
         r.x = r.y = 0;
@@ -5072,8 +5095,8 @@ static void d3d11_flip(uint32_t surface_offset, uint32_t pitch)
          * filter has anything to do: the frame is copied as it is, at
          * scale > 1 too (the compositor gets the scaled frame whole). */
         /* A display.overscan crop always blits: a copy shows the edges. */
-        int blit = !stock && (eo->overscan
-                || !(same && (eo->present_filter != NV2A_PRESENT_LINEAR || internal)));
+        int blit = wide_frame(s_drawn) || (!stock && (eo->overscan
+                || !(same && (eo->present_filter != NV2A_PRESENT_LINEAR || internal))));
 #ifdef XBOXRECOMP_ENHANCE
         /* present.shader: the chain reads the whole frame, so a display.overscan
          * crop has no place in it. */
diff --git a/src/kernel/kernel.h b/src/kernel/kernel.h
index 1c53e6a..b21cc8f 100644
--- a/src/kernel/kernel.h
+++ b/src/kernel/kernel.h
@@ -1311,11 +1311,22 @@ NTSTATUS __stdcall xbox_ExSaveNonVolatileSetting(ULONG ValueIndex, ULONG Type, P
 #define XC_PARENTAL_CONTROL       XC_P_CONTROL_GAMES
 #define XC_PARENTAL_PASSWORD      XC_P_CONTROL_PASSWORD
 
-/* Video standard flags in XC_VIDEO */
-#define XC_VIDEO_FLAGS_WIDESCREEN   0x01
-#define XC_VIDEO_FLAGS_HDTV         0x02
-#define XC_VIDEO_FLAGS_PAL_I        0x04
-#define XC_VIDEO_FLAGS_LETTERBOX    0x10
+/* Video flags in XC_VIDEO, as the EEPROM holds them: the XDK's
+ * XGetVideoFlags returns (value >> 16) & 0x5F, so the low bits mean nothing.
+ * (These were 0x01 / 0x02 / ..., which a title read as no flag at all.) */
+#define XC_VIDEO_FLAGS_WIDESCREEN   0x00010000
+#define XC_VIDEO_FLAGS_HDTV_720p    0x00020000
+#define XC_VIDEO_FLAGS_HDTV_1080i   0x00040000
+#define XC_VIDEO_FLAGS_HDTV_480p    0x00080000
+#define XC_VIDEO_FLAGS_LETTERBOX    0x00100000
+#define XC_VIDEO_FLAGS_PAL_60Hz     0x00400000
+#define XC_VIDEO_FLAGS_HDTV         XC_VIDEO_FLAGS_HDTV_480p
+
+/* rdr-port: whether XC_VIDEO reports a widescreen TV (default no, which is
+ * what every title saw before the values above were fixed). A title reads it
+ * at boot to pick its video mode. RECOMP_WIDESCREEN=1 turns it on. */
+void xbox_VideoWidescreenSet(int on);
+int  xbox_VideoWidescreen(void);
 
 /* Unknown ordinals - stub */
 VOID    __stdcall xbox_Unknown_8(void);
diff --git a/src/kernel/kernel_xbox.c b/src/kernel/kernel_xbox.c
index afaff4f..c27eecb 100644
--- a/src/kernel/kernel_xbox.c
+++ b/src/kernel/kernel_xbox.c
@@ -10,9 +10,27 @@
  */
 
 #include "kernel.h"
+#include <stdlib.h>
 #include <string.h>
 #include <time.h>
 
+/* rdr-port: XC_VIDEO's widescreen flag (kernel.h). */
+static int s_widescreen = -1;
+
+void xbox_VideoWidescreenSet(int on)
+{
+    s_widescreen = on != 0;
+}
+
+int xbox_VideoWidescreen(void)
+{
+    if (s_widescreen < 0) {
+        const char *e = getenv("RECOMP_WIDESCREEN");
+        s_widescreen = e && *e == '1';
+    }
+    return s_widescreen;
+}
+
 /* ============================================================================
  * Exported Data Objects
  *
@@ -222,9 +240,9 @@ NTSTATUS __stdcall xbox_ExQueryNonVolatileSetting(
         break;
 
     case XC_VIDEO:
-        /* NTSC with widescreen and HDTV support enabled */
+        /* NTSC; widescreen only when asked (xbox_VideoWidescreen) */
         if (ValueLength >= sizeof(ULONG)) {
-            *(PULONG)Value = XC_VIDEO_FLAGS_WIDESCREEN | XC_VIDEO_FLAGS_HDTV;
+            *(PULONG)Value = xbox_VideoWidescreen() ? XC_VIDEO_FLAGS_WIDESCREEN : 0;
             if (Type) *Type = 4; /* REG_DWORD */
             if (ResultLength) *ResultLength = sizeof(ULONG);
         }
@@ -315,7 +333,7 @@ NTSTATUS __stdcall xbox_ExQueryNonVolatileSetting(
         memcpy(blk + 0x28, &s_tz.std_bias, 4);
         memcpy(blk + 0x2C, &s_tz.dlt_bias, 4);
         { ULONG v = 1; memcpy(blk + 0x30, &v, 4); }                       /* English */
-        { ULONG v = XC_VIDEO_FLAGS_WIDESCREEN | XC_VIDEO_FLAGS_HDTV; memcpy(blk + 0x34, &v, 4); }
+        { ULONG v = xbox_VideoWidescreen() ? XC_VIDEO_FLAGS_WIDESCREEN : 0; memcpy(blk + 0x34, &v, 4); }
         /* 0x58 is MiscFlags (0); DvdRegion is the last field, at 0x5C. */
         { ULONG v = 1; memcpy(blk + 0x5C, &v, 4); }                       /* DVD region 1 */
         if (Type) *Type = 3;

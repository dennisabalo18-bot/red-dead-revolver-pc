From 27db367c5692605e7d41364748cc75c5fad1f93f Mon Sep 17 00:00:00 2001
From: rdr-port <rdr-port@users.noreply.github.com>
Date: Fri, 30 Oct 2026 02:14:25 -0300
Subject: [PATCH 1/3] KeBugCheck: dump guest stack code addresses and strings

A title's fatal-error path reaches KeBugCheck with the message it was
given still on the guest stack. Print the caller, every stack slot that
looks like a .text return address, and every slot that points at
readable ASCII, so the error that fired is named instead of guessed.
Address ranges are Red Dead Revolver's image and the runtime heap.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kernel/kernel_bridge.c | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/src/kernel/kernel_bridge.c b/src/kernel/kernel_bridge.c
index 10d00f4..b6ae90e 100644
--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -2344,10 +2344,45 @@ static void bridge_KeDelayExecutionThread(void)
  * failure surfaced later somewhere unrelated. Report the code and stop
  * pretending the call succeeded.
  */
+/* rdr-port diagnostic: dump guest stack slots that look like return addresses
+ * into .text, and any that point at readable ASCII (an error message passed
+ * down to the fatal-error path). Ranges are Red Dead Revolver's image and the
+ * runtime heap, so every read stays inside mapped guest memory. */
+static int bugcheck_guest_readable(uint32_t va)
+{
+    return (va >= 0x00010000u && va < 0x00838940u) ||
+           (va >= 0x010C0000u && va < 0x04000000u);
+}
+
+static void bugcheck_dump_guest_stack(void)
+{
+    fprintf(stderr, "  [BUGCHECK] caller=0x%08X esp=0x%08X\n",
+            g_xbox_kernel_caller, g_esp);
+    for (uint32_t i = 0; i < 1024; i++) {
+        uint32_t slot = g_esp + i * 4;
+        if (slot >= 0x010C0000u)
+            break;
+        uint32_t v = BRIDGE_MEM32(slot);
+        if (v >= 0x00011000u && v < 0x00338620u) {
+            fprintf(stderr, "  [BUGCHECK]   [esp+%03X] code 0x%08X\n", i * 4, v);
+        } else if (bugcheck_guest_readable(v) && bugcheck_guest_readable(v + 64)) {
+            const unsigned char *s = (const unsigned char *)XBOX_TO_NATIVE(v);
+            int n = 0;
+            while (n < 160 && s[n] >= 0x20 && s[n] < 0x7F)
+                n++;
+            if (n >= 6 && (s[n] == 0 || s[n] == '\n'))
+                fprintf(stderr, "  [BUGCHECK]   [esp+%03X] str  0x%08X \"%.*s\"\n",
+                        i * 4, v, n, (const char *)s);
+        }
+    }
+    fflush(stderr);
+}
+
 static void bridge_KeBugCheck(void)
 {
     fprintf(stderr, "  [KERNEL] *** KeBugCheck: code=0x%08X ***\n",
             STACK_ARG(0));
+    bugcheck_dump_guest_stack();
     fflush(stderr);
     g_eax = 0;
 }

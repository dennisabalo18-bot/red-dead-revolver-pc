From b2e29372f3ce983bb153ca92890027c5947360ee Mon Sep 17 00:00:00 2001
From: rdr-port <rdr-port@users.noreply.github.com>
Date: Fri, 30 Oct 2026 02:14:25 -0300
Subject: [PATCH 2/3] Pushbuffer executor: make the parallel-raster threshold
 tunable

RECOMP_RASTER_MT_MIN=<pixels> overrides NV_RASTER_MT_MIN_PIXELS, the
batch size below which the executor rasterises alone. Red Dead
Revolver's front end is ~1000 small draws a frame, nearly all under the
8192-pixel default, so the worker pool sat idle; 128 took the menu from
3.0 to 3.7 fps.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kernel/nv2a_pb_exec.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/src/kernel/nv2a_pb_exec.c b/src/kernel/nv2a_pb_exec.c
index a513bc7..2be8706 100644
--- a/src/kernel/nv2a_pb_exec.c
+++ b/src/kernel/nv2a_pb_exec.c
@@ -2551,12 +2551,26 @@ static int raster_pool_size(void)
     return s_pool.n;
 }
 
+/* rdr-port: RECOMP_RASTER_MT_MIN=<pixels> overrides the batch size below
+ * which the executor rasterises alone. Red Dead Revolver's front end is ~1000
+ * small draws a frame, nearly all under the default, so the pool sat idle. */
+static long raster_mt_min_pixels(void)
+{
+    static long v = -1;
+    if (v < 0) {
+        const char *e = getenv("RECOMP_RASTER_MT_MIN");
+        v = (e && *e) ? atol(e) : NV_RASTER_MT_MIN_PIXELS;
+        if (v < 0) v = NV_RASTER_MT_MIN_PIXELS;
+    }
+    return v;
+}
+
 static void xf_rows_parallel(const XfTri *T, int ntris, long px,
                              XfCount *total)
 {
     int n = raster_pool_size(), k;
 
-    if (n <= 1 || px < NV_RASTER_MT_MIN_PIXELS) {
+    if (n <= 1 || px < raster_mt_min_pixels()) {
         for (k = 0; k < ntris; k++)
             xf_rows(&T[k], T[k].miny, 1, total);
         return;
-- 
